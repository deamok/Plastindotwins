datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STAFF
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum LocationType {
  STORAGE // Hanya sebagai penyimpanan (Gudang Bangetayu)
  OUTLET  // Merangkap outlet penjualan & toko (Outlet Jomblang)
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  name           String
  role           Role            @default(STAFF)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sales          Sale[]
  purchases      Purchase[]
  stockTransfers StockTransfer[]
}

model Contact {
  id                String       @id @default(uuid())
  name              String
  type              ContactType  @default(CUSTOMER) // CUSTOMER, SUPPLIER, BOTH
  phone             String?
  email             String?
  address           String?
  bankName          String?      // Nama Bank (misal: BCA, Mandiri, BRI, BNI)
  bankAccountNo     String?      // Nomor Rekening
  bankAccountHolder String?      // Nama Pemilik Rekening / Atas Nama
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  sales             Sale[]
  purchases         Purchase[]
}

model Location {
  id            String          @id @default(uuid())
  code          String          @unique // BANGETAYU, JOMBLANG
  name          String          // Gudang Bangetayu, Outlet Jomblang
  type          LocationType    @default(STORAGE)
  address       String?
  description   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  stocks        ProductStock[]
  transfersFrom StockTransfer[] @relation("TransferSource")
  transfersTo   StockTransfer[] @relation("TransferDest")
  transactions  Transaction[]
  sales         Sale[]
  purchases     Purchase[]
}

model Product {
  id                   String          @id @default(uuid())
  sku                  String          @unique
  name                 String
  category             String?
  subCategory          String?
  description          String?
  stock                Int             @default(0) // Total stok gabungan semua lokasi (dalam satuan jual: buah/pak/pcs)
  minStock             Int             @default(5)
  unit                 String          @default("buah") // Satuan jual: buah, pak, pcs, lembar
  purchaseUnit         String          @default("kg")   // Satuan beli: kg, karung, bal, dus
  itemsPerPurchaseUnit Decimal         @default(1) @db.Decimal(10, 2) // Jumlah buah/pak per 1 kg
  price                Decimal         @db.Decimal(10, 2) // Harga Jual per satuan jual (buah/pak)
  costPrice            Decimal         @default(0) @db.Decimal(10, 2) // Estimasi Harga Beli Modal per kg
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  stocks               ProductStock[]
  transactions         Transaction[]
  stockTransfers       StockTransfer[]
  saleItems            SaleItem[]
  purchaseItems        PurchaseItem[]

  @@index([category])
  @@index([subCategory])
}

model ProductStock {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  stock      Int      @default(0) // Stok dasar barang di lokasi ini
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
}

model StockTransfer {
  id               String   @id @default(uuid())
  transferNo       String   @unique // TRF-20260926-1234
  sourceLocationId String
  sourceLocation   Location @relation("TransferSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destLocationId   String
  destLocation     Location @relation("TransferDest", fields: [destLocationId], references: [id], onDelete: Restrict)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity         Int      // Jumlah unit dasar produk yang ditransfer
  notes            String?
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
}

model Transaction {
  id         String          @id @default(uuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  type       TransactionType
  quantity   Int
  notes      String?
  createdAt  DateTime        @default(now())
}

model Sale {
  id            String     @id @default(uuid())
  invoiceNo     String     @unique
  customerName  String
  contactId     String?
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  locationId    String?
  location      Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  totalAmount   Decimal    @db.Decimal(12, 2)
  paymentMethod String     @default("CASH") // CASH, TRANSFER, TEMPO
  notes         String?
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         SaleItem[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model SaleItem {
  id           String   @id @default(uuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  saleQty      Decimal  @default(1) @db.Decimal(10, 2) // Jumlah yang dijual dalam satuan terpilih (misal: 2 lusin atau 5 pack)
  saleUnit     String   @default("buah") // Satuan transaksi penjualan: buah, pcs, lusin, pak/pack, kodi, dus, dll.
  itemsPerUnit Decimal  @default(1) @db.Decimal(10, 2) // Rasio konversi: berapa unit stok dasar per 1 satuan penjualan
  quantity     Int      // Total unit stok fisik yang berkurang dalam satuan dasar produk (buah/pak)
  unitPrice    Decimal  @db.Decimal(10, 2) // Harga per satuan transaksi terpilih
  subtotal     Decimal  @db.Decimal(12, 2) // saleQty * unitPrice
  createdAt    DateTime @default(now())
}

model Purchase {
  id            String         @id @default(uuid())
  purchaseNo    String         @unique
  supplierName  String
  contactId     String?
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  locationId    String?
  location      Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  totalAmount   Decimal        @db.Decimal(12, 2)
  paymentStatus String         @default("PAID") // PAID, PENDING
  notes         String?
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         PurchaseItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PurchaseItem {
  id           String   @id @default(uuid())
  purchaseId   String
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  purchaseQty  Decimal  @default(1) @db.Decimal(10, 2) // Jumlah dibeli dalam satuan beli (misal 20 kg)
  purchaseUnit String   @default("kg") // Satuan beli (misal kg)
  itemsPerUnit Decimal  @default(1) @db.Decimal(10, 2) // Konversi: berapa buah/pak per kg saat beli
  quantity     Int      // Total unit stok bertambah dalam satuan jual (buah/pak)
  costPrice    Decimal  @db.Decimal(10, 2) // Harga beli per kg
  subtotal     Decimal  @db.Decimal(12, 2) // purchaseQty * costPrice
  createdAt    DateTime @default(now())
}
