datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STAFF
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  role      Role       @default(STAFF)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  sales     Sale[]
  purchases Purchase[]
}

model Contact {
  id                String       @id @default(uuid())
  name              String
  type              ContactType  @default(CUSTOMER) // CUSTOMER, SUPPLIER, BOTH
  phone             String?
  email             String?
  address           String?
  bankName          String?      // Nama Bank (misal: BCA, Mandiri, BRI, BNI)
  bankAccountNo     String?      // Nomor Rekening
  bankAccountHolder String?      // Nama Pemilik Rekening / Atas Nama
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  sales             Sale[]
  purchases         Purchase[]
}

model Product {
  id                   String         @id @default(uuid())
  sku                  String         @unique
  name                 String
  description          String?
  stock                Int            @default(0) // Stok dasar dalam satuan jual (buah/pak/pcs)
  minStock             Int            @default(5)
  unit                 String         @default("buah") // Satuan jual: buah, pak, pcs, lembar
  purchaseUnit         String         @default("kg")   // Satuan beli: kg, karung, bal, dus
  itemsPerPurchaseUnit Decimal        @default(1) @db.Decimal(10, 2) // Jumlah buah/pak per 1 kg (bervariasi tiap barang!)
  price                Decimal        @db.Decimal(10, 2) // Harga Jual per satuan jual (buah/pak)
  costPrice            Decimal        @default(0) @db.Decimal(10, 2) // Estimasi Harga Beli Modal per kg
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  transactions         Transaction[]
  saleItems            SaleItem[]
  purchaseItems        PurchaseItem[]
}

model Transaction {
  id        String          @id @default(uuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      TransactionType
  quantity  Int
  notes     String?
  createdAt DateTime        @default(now())
}

model Sale {
  id            String     @id @default(uuid())
  invoiceNo     String     @unique
  customerName  String
  contactId     String?
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  totalAmount   Decimal    @db.Decimal(12, 2)
  paymentMethod String     @default("CASH") // CASH, TRANSFER, TEMPO
  notes         String?
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         SaleItem[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model SaleItem {
  id           String   @id @default(uuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  saleQty      Decimal  @default(1) @db.Decimal(10, 2) // Jumlah yang dijual dalam satuan terpilih (misal: 2 lusin atau 5 pack)
  saleUnit     String   @default("buah") // Satuan transaksi penjualan: buah, pcs, lusin, pak/pack, kodi, dus, dll.
  itemsPerUnit Decimal  @default(1) @db.Decimal(10, 2) // Rasio konversi: berapa unit stok dasar per 1 satuan penjualan (misal: 12 untuk lusin, 50 untuk pack)
  quantity     Int      // Total unit stok fisik yang berkurang dalam satuan dasar produk (buah/pak)
  unitPrice    Decimal  @db.Decimal(10, 2) // Harga per satuan transaksi terpilih
  subtotal     Decimal  @db.Decimal(12, 2) // saleQty * unitPrice
  createdAt    DateTime @default(now())
}

model Purchase {
  id            String         @id @default(uuid())
  purchaseNo    String         @unique
  supplierName  String
  contactId     String?
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  totalAmount   Decimal        @db.Decimal(12, 2)
  paymentStatus String         @default("PAID") // PAID, PENDING
  notes         String?
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         PurchaseItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PurchaseItem {
  id           String   @id @default(uuid())
  purchaseId   String
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  purchaseQty  Decimal  @default(1) @db.Decimal(10, 2) // Jumlah dibeli dalam satuan beli (misal 20 kg)
  purchaseUnit String   @default("kg") // Satuan beli (misal kg)
  itemsPerUnit Decimal  @default(1) @db.Decimal(10, 2) // Konversi: berapa buah/pak per kg saat beli
  quantity     Int      // Total unit stok bertambah dalam satuan jual (buah/pak)
  costPrice    Decimal  @db.Decimal(10, 2) // Harga beli per kg
  subtotal     Decimal  @db.Decimal(12, 2) // purchaseQty * costPrice
  createdAt    DateTime @default(now())
}
